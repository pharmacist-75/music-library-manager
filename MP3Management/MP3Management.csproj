    <ProjectGuid>{15452491-B8F4-4CA5-AEF0-04E25CF43770}</ProjectGuid>
  </PropertyGroup>
  
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
